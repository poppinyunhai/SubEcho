{
  "manifest_version": 3,
  "name": "SubEcho · 字幕回声",
  "version": "0.3.3",
  "description": "用小米 MiMo 流式朗读 YouTube 当前显示的字幕。",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://api.xiaomimimo.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_title": "SubEcho · 字幕回声"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "core.js",
        "captions.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
